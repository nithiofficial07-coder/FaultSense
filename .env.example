# ==============================================================================
# FaultSense Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=false

# Storage & File Paths
DATABASE_PATH=data/fault_sense.db
DATA_DIR=data
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
LOG_DIR=logs
LOG_FILE=logs/fault_sense.log
LOG_LEVEL=INFO

# Ingestion Settings
MAX_UPLOAD_SIZE_MB=50

# Retrieval & Vector Database
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_TYPE=faiss_cpu
FAISS_INDEX_DIR=data/vector_store/faiss
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.60

# LLM Provider Configuration
# Supported providers: openai, gemini, anthropic, mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Provider Credentials (read from environment variables, never hardcoded)
# Set appropriate key for your chosen provider:
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# When DEMO_MODE is true or no credentials are provided, FaultSense
# uses the deterministic fallback reasoning engine (100% offline).
DEMO_MODE=true

